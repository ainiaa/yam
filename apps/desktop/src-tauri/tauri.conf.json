{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YAM",
  "version": "0.1.0",
  "identifier": "com.yam.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:terminal && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:terminal",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YAM",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "resources": [
      "target/terminal-runtime/yam-terminal",
      "target/terminal-runtime/THIRD-PARTY-NOTICES.txt"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "yam"
        ]
      }
    }
  }
}
