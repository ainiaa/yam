{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && pnpm build:terminal --script-only --notice-mode release"
  },
  "bundle": {
    "resources": [
      "target/terminal-runtime/yam-terminal.cjs",
      "target/terminal-runtime/THIRD-PARTY-NOTICES.txt",
      "target/terminal-runtime/THIRD-PARTY-NOTICES.report.json"
    ],
    "createUpdaterArtifacts": true
  }
}
